# Server Configuration
NODE_ENV=development
PORT=3000

# Database (Prisma)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase (for Storage only)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=gradients

# Authentication
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
JWT_SECRET=your_jwt_secret

# AI Services Configuration
# Provider Options: openai, openrouter
AI_PROVIDER=openai

# OpenAI Configuration (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter Configuration (required if AI_PROVIDER=openrouter)
# OpenRouter supports many models including Gemini, Claude, GPT, etc.
# Get your API key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key

# AI Model Selection
# For OpenAI: gpt-4-turbo-preview, gpt-4o, gpt-3.5-turbo
# For OpenRouter: google/gemini-2.0-flash-exp:free, anthropic/claude-3-sonnet, etc.
AI_MODEL=gpt-4-turbo-preview

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cors
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
